{
  "kind": "collectionType",
  "collectionName": "tenants",
  "info": {
    "singularName": "tenant",
    "pluralName": "tenants",
    "displayName": "Tenant",
    "description": "Multi-tenant sites (e.g. MOSC, Catholicate News)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "tenantId": {
      "type": "string",
      "required": true,
      "unique": true,
      "description": "Programmatic ID from frontend (e.g. tenant_demo_002). Use this for API filtering."
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "pluginOptions": {
        "content-manager": {
          "description": "Lowercase kebab-case only (e.g. tenant-demo-002). Use letters, numbers, and hyphens."
        }
      }
    },
    "domain": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 255
    }
  }
}
